		<properties node_id="5" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\xff\xff\xff\xff\xff\xff\xff\xf8\x00\x00\x07\x80\x00\x00\x04\x80\x00\x00\x04\x05\x00\x00\x01\xce\x00\x00\x07/\x00\x00\x04%\x00\x00\x00\x00\x02\x00\x00\x00\x07\x80\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x07\x7f\x00\x00\x04\x7f', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\nimport pandas as pd\nfrom Orange.data.pandas_compat import table_to_frame, table_from_frame\n\n# ------------------------- PENGATURAN -------------------------\nKOLOM_TANGGAL = "minggu_mulai"\nRASIO_LATIH = 0.8                                   # 80% minggu awal = data latih\nNILAI_K = [2, 3, 4]                                 # jendela Moving Average\nNILAI_ALPHA = [round(a / 10, 1) for a in range(1, 10)]   # 0.1 ... 0.9\nAMBANG_MAPE = 5      # minggu dengan penjualan aktual &lt; 5 dikeluarkan dari hitungan MAPE\n                     # (MAPE meledak kalau dibagi angka yang nyaris 0)\n# --------------------------------------------------------------\n\ndf = table_to_frame(in_data, include_metas=True)\nif KOLOM_TANGGAL in df.columns:\n    df = df.sort_values(KOLOM_TANGGAL).reset_index(drop=True)\nobat_list = [c for c in df.columns\n             if c != KOLOM_TANGGAL and pd.api.types.is_numeric_dtype(df[c])]\n\nn = len(df)\nn_latih = int(round(n * RASIO_LATIH))\nmulai_eval = max(NILAI_K)          # semua metode dievaluasi pada minggu yang SAMA\n\n\ndef prediksi_ma(y, k):\n    """Prediksi minggu t = rata-rata k minggu sebelumnya. Minggu awal = NaN."""\n    f = np.full(len(y), np.nan)\n    for t in range(k, len(y)):\n        f[t] = y[t - k:t].mean()\n    return f\n\n\ndef prediksi_ses(y, alpha):\n    """F[t+1] = alpha*y[t] + (1-alpha)*F[t], dengan F[1] = y[0]."""\n    f = np.full(len(y), np.nan)\n    f[1] = y[0]\n    for t in range(1, len(y) - 1):\n        f[t + 1] = alpha * y[t] + (1 - alpha) * f[t]\n    return f\n\n\ndef prediksi_depan_ma(y, k):\n    return y[-k:].mean()\n\n\ndef prediksi_depan_ses(y, alpha):\n    f = prediksi_ses(y, alpha)\n    return alpha * y[-1] + (1 - alpha) * f[-1]\n\n\ndef metrik(y, f, idx):\n    """MAPE (minggu aktual &lt; AMBANG_MAPE dikeluarkan), MAE, RMSE pada indeks idx."""\n    a, p = y[idx], f[idx]\n    ok = ~np.isnan(p)\n    a, p = a[ok], p[ok]\n    nol = int((a &lt; AMBANG_MAPE).sum())\n    nz = a &gt;= AMBANG_MAPE\n    mape = np.mean(np.abs((a[nz] - p[nz]) / a[nz])) * 100 if nz.any() else np.nan\n    mae = np.mean(np.abs(a - p))\n    rmse = np.sqrt(np.mean((a - p) ** 2))\n    return mape, mae, rmse, nol\n\n\nbaris = []\nfor obat in obat_list:\n    y = df[obat].to_numpy(dtype=float)\n    idx_latih = np.arange(mulai_eval, n_latih)\n    idx_uji = np.arange(n_latih, n)\n\n    konfigurasi = ([("Moving Average", f"k={k}", prediksi_ma(y, k), prediksi_depan_ma(y, k))\n                    for k in NILAI_K] +\n                   [("SES", f"alpha={a}", prediksi_ses(y, a), prediksi_depan_ses(y, a))\n                    for a in NILAI_ALPHA])\n\n    for metode, param, f, f_depan in konfigurasi:\n        mape_l, _, _, _ = metrik(y, f, idx_latih)\n        mape_u, mae_u, rmse_u, nol_u = metrik(y, f, idx_uji)\n        baris.append({\n            "obat": obat, "metode": metode, "parameter": param,\n            "MAPE_latih_%": round(mape_l, 2), "MAPE_uji_%": round(mape_u, 2),\n            "MAE_uji": round(mae_u, 1), "RMSE_uji": round(rmse_u, 1),\n            "minggu_dikeluarkan_uji": nol_u, "prediksi_minggu_depan": round(f_depan, 1),\n        })\n\nhasil = pd.DataFrame(baris)\n\n# Parameter terbaik dipilih dari MAPE data LATIH (bukan data uji), lalu dilaporkan MAPE ujinya\nterbaik = (hasil.sort_values("MAPE_latih_%")\n           .groupby(["obat", "metode"], as_index=False).first())\n\nprint("=== PARAMETER TERBAIK per obat per metode (dipilih dari MAPE data latih) ===")\nprint(terbaik[["obat", "metode", "parameter", "MAPE_latih_%", "MAPE_uji_%",\n               "prediksi_minggu_depan"]].to_string(index=False))\nprint("\\nMinggu latih:", n_latih, "| minggu uji:", n - n_latih,\n      "| minggu pertama yang dievaluasi: ke-", mulai_eval + 1)\n\n# Output ke Data Table: semua kombinasi (bisa diurutkan di Data Table)\nout_data = table_from_frame(hasil)\n\n# Orange versi baru menutup script dengan:\n#   return out_data, out_learner, out_classifier, out_object\n# jadi tiga variabel ini harus ada (boleh kosong).\nout_learner = None\nout_classifier = None\nout_object = None', 'filename': None}], 'scriptText': 'import numpy as np\nimport pandas as pd\nfrom Orange.data.pandas_compat import table_to_frame, table_from_frame\n\n# ------------------------- PENGATURAN -------------------------\nKOLOM_TANGGAL = "minggu_mulai"\nRASIO_LATIH = 0.8                                   # 80% minggu awal = data latih\nNILAI_K = [2, 3, 4]                                 # jendela Moving Average\nNILAI_ALPHA = [round(a / 10, 1) for a in range(1, 10)]   # 0.1 ... 0.9\nAMBANG_MAPE = 5      # minggu dengan penjualan aktual &lt; 5 dikeluarkan dari hitungan MAPE\n                     # (MAPE meledak kalau dibagi angka yang nyaris 0)\n# --------------------------------------------------------------\n\ndf = table_to_frame(in_data, include_metas=True)\nif KOLOM_TANGGAL in df.columns:\n    df = df.sort_values(KOLOM_TANGGAL).reset_index(drop=True)\nobat_list = [c for c in df.columns\n             if c != KOLOM_TANGGAL and pd.api.types.is_numeric_dtype(df[c])]\n\nn = len(df)\nn_latih = int(round(n * RASIO_LATIH))\nmulai_eval = max(NILAI_K)          # semua metode dievaluasi pada minggu yang SAMA\n\n\ndef prediksi_ma(y, k):\n    """Prediksi minggu t = rata-rata k minggu sebelumnya. Minggu awal = NaN."""\n    f = np.full(len(y), np.nan)\n    for t in range(k, len(y)):\n        f[t] = y[t - k:t].mean()\n    return f\n\n\ndef prediksi_ses(y, alpha):\n    """F[t+1] = alpha*y[t] + (1-alpha)*F[t], dengan F[1] = y[0]."""\n    f = np.full(len(y), np.nan)\n    f[1] = y[0]\n    for t in range(1, len(y) - 1):\n        f[t + 1] = alpha * y[t] + (1 - alpha) * f[t]\n    return f\n\n\ndef prediksi_depan_ma(y, k):\n    return y[-k:].mean()\n\n\ndef prediksi_depan_ses(y, alpha):\n    f = prediksi_ses(y, alpha)\n    return alpha * y[-1] + (1 - alpha) * f[-1]\n\n\ndef metrik(y, f, idx):\n    """MAPE (minggu aktual &lt; AMBANG_MAPE dikeluarkan), MAE, RMSE pada indeks idx."""\n    a, p = y[idx], f[idx]\n    ok = ~np.isnan(p)\n    a, p = a[ok], p[ok]\n    nol = int((a &lt; AMBANG_MAPE).sum())\n    nz = a &gt;= AMBANG_MAPE\n    mape = np.mean(np.abs((a[nz] - p[nz]) / a[nz])) * 100 if nz.any() else np.nan\n    mae = np.mean(np.abs(a - p))\n    rmse = np.sqrt(np.mean((a - p) ** 2))\n    return mape, mae, rmse, nol\n\n\nbaris = []\nfor obat in obat_list:\n    y = df[obat].to_numpy(dtype=float)\n    idx_latih = np.arange(mulai_eval, n_latih)\n    idx_uji = np.arange(n_latih, n)\n\n    konfigurasi = ([("Moving Average", f"k={k}", prediksi_ma(y, k), prediksi_depan_ma(y, k))\n                    for k in NILAI_K] +\n                   [("SES", f"alpha={a}", prediksi_ses(y, a), prediksi_depan_ses(y, a))\n                    for a in NILAI_ALPHA])\n\n    for metode, param, f, f_depan in konfigurasi:\n        mape_l, _, _, _ = metrik(y, f, idx_latih)\n        mape_u, mae_u, rmse_u, nol_u = metrik(y, f, idx_uji)\n        baris.append({\n            "obat": obat, "metode": metode, "parameter": param,\n            "MAPE_latih_%": round(mape_l, 2), "MAPE_uji_%": round(mape_u, 2),\n            "MAE_uji": round(mae_u, 1), "RMSE_uji": round(rmse_u, 1),\n            "minggu_dikeluarkan_uji": nol_u, "prediksi_minggu_depan": round(f_depan, 1),\n        })\n\nhasil = pd.DataFrame(baris)\n\n# Parameter terbaik dipilih dari MAPE data LATIH (bukan data uji), lalu dilaporkan MAPE ujinya\nterbaik = (hasil.sort_values("MAPE_latih_%")\n           .groupby(["obat", "metode"], as_index=False).first())\n\nprint("=== PARAMETER TERBAIK per obat per metode (dipilih dari MAPE data latih) ===")\nprint(terbaik[["obat", "metode", "parameter", "MAPE_latih_%", "MAPE_uji_%",\n               "prediksi_minggu_depan"]].to_string(index=False))\nprint("\\nMinggu latih:", n_latih, "| minggu uji:", n - n_latih,\n      "| minggu pertama yang dievaluasi: ke-", mulai_eval + 1)\n\n# Output ke Data Table: semua kombinasi (bisa diurutkan di Data Table)\nout_data = table_from_frame(hasil)\n\n# Orange versi baru menutup script dengan:\n#   return out_data, out_learner, out_classifier, out_object\n# jadi tiga variabel ini harus ada (boleh kosong).\nout_learner = None\nout_classifier = None\nout_object = None', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xa1\x00\x00\x00b\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
